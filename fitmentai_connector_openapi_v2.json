{
  "openapi": "3.0.3",
  "info": {
    "title": "FITMENT.AI Screening API",
    "version": "1.0.0",
    "description": "FITMENT.AI deterministic resume screening service integrated with Microsoft Power Platform, Power Automate, and Copilot Studio. 100% offline rule-based scoring with zero external LLM dependencies.",
    "contact": {
      "name": "FITMENT.AI Architecture Team",
      "url": "https://github.com/tarun1-github/Resume-Screening"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Verifies service availability and zero-LLM operational mode.",
        "operationId": "GetHealthStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/screen-text": {
      "post": {
        "summary": "Screen Candidate Text",
        "description": "Evaluates candidate resume text against job description text deterministically. Returns score, matched/missing skills, citations, and interview probes.",
        "operationId": "ScreenCandidateText",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScreenTextRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScreeningResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-ms-visibility": "important"
      }
    }
  },
  "components": {
    "schemas": {
      "CandidateMetadata": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "default": "Candidate Profile"
          },
          "mobile": {
            "type": "string",
            "nullable": true,
            "title": "Mobile"
          },
          "email": {
            "type": "string",
            "nullable": true,
            "title": "Email"
          },
          "location": {
            "type": "string",
            "nullable": true,
            "title": "Location"
          },
          "dob": {
            "type": "string",
            "nullable": true,
            "title": "Dob"
          },
          "total_exp": {
            "type": "string",
            "nullable": true,
            "title": "Total Exp"
          },
          "relevant_exp": {
            "type": "string",
            "nullable": true,
            "title": "Relevant Exp"
          },
          "organization": {
            "type": "string",
            "nullable": true,
            "title": "Organization"
          },
          "current_designation": {
            "type": "string",
            "nullable": true,
            "title": "Current Designation"
          },
          "previous_organizations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Previous Organizations"
          },
          "education": {
            "type": "string",
            "nullable": true,
            "title": "Education"
          },
          "certifications": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Certifications"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "CandidateMetadata"
      },
      "GroundedRecommendation": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "x-ms-summary": "Response Status"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "score": {
            "type": "integer",
            "title": "Score"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "strengths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strengths"
          },
          "gaps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Gaps"
          },
          "interview_probes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interview Probes"
          },
          "is_llm": {
            "type": "boolean",
            "title": "Is Llm",
            "default": false
          },
          "engine_label": {
            "type": "string",
            "title": "Engine Label"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "status",
          "action",
          "score",
          "summary",
          "engine_label"
        ],
        "title": "GroundedRecommendation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ScreenTextRequest": {
        "properties": {
          "job_description": {
            "type": "string",
            "title": "Job Description",
            "description": "Target Job Description text.",
            "x-ms-summary": "Job Description Text"
          },
          "resume_text": {
            "type": "string",
            "title": "Resume Text",
            "description": "Candidate Resume plain text.",
            "x-ms-summary": "Candidate Resume Plain Text"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "nullable": true,
            "title": "Weights",
            "description": "Optional scoring weights: skills, exp, edu, extras.",
            "x-ms-summary": "Scoring Weights (Optional)"
          }
        },
        "type": "object",
        "required": [
          "job_description",
          "resume_text"
        ],
        "title": "ScreenTextRequest"
      },
      "ScreeningResponse": {
        "properties": {
          "candidate_name": {
            "type": "string",
            "title": "Candidate Name",
            "x-ms-summary": "Candidate Name"
          },
          "match_score": {
            "type": "integer",
            "title": "Match Score",
            "x-ms-summary": "Match Score (0-100)"
          },
          "score_type": {
            "type": "string",
            "title": "Score Type",
            "x-ms-summary": "Scoring Methodology"
          },
          "verdict": {
            "type": "string",
            "title": "Verdict",
            "x-ms-summary": "Screening Verdict"
          },
          "recommendation": {
            "type": "string",
            "title": "Recommendation",
            "x-ms-summary": "Recruitment Recommendation"
          },
          "skills_matched": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills Matched",
            "x-ms-summary": "Skills Matched"
          },
          "missing_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Skills",
            "x-ms-summary": "Missing Skills"
          },
          "supporting_evidence": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Supporting Evidence",
            "x-ms-summary": "Supporting Evidence Quotes"
          },
          "total_experience_detected": {
            "type": "string",
            "title": "Total Experience Detected",
            "x-ms-summary": "Total Experience Detected"
          },
          "experience_assessment": {
            "type": "string",
            "title": "Experience Assessment",
            "x-ms-summary": "Experience Assessment"
          },
          "certifications_detected": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Certifications Detected",
            "x-ms-summary": "Certifications Detected"
          },
          "interview_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Interview Questions",
            "x-ms-summary": "Targeted Interview Questions"
          },
          "human_review_required": {
            "type": "boolean",
            "title": "Human Review Required",
            "x-ms-summary": "Human Review Required Flag"
          },
          "metadata": {
            "$ref": "#/components/schemas/CandidateMetadata",
            "x-ms-summary": "Candidate Profile Metadata"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "x-ms-summary": "Response Status"
          },
          "skill_gaps_analysis": {
            "$ref": "#/components/schemas/SkillGapsAnalysis",
            "nullable": true,
            "x-ms-summary": "Skill Gaps Breakdown"
          },
          "grounded_recommendation": {
            "$ref": "#/components/schemas/GroundedRecommendation",
            "nullable": true,
            "x-ms-summary": "Grounded Recommendation Details"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "candidate_name",
          "match_score",
          "score_type",
          "verdict",
          "recommendation",
          "skills_matched",
          "missing_skills",
          "supporting_evidence",
          "total_experience_detected",
          "experience_assessment",
          "certifications_detected",
          "interview_questions",
          "human_review_required",
          "status"
        ],
        "title": "ScreeningResponse"
      },
      "SkillGapItem": {
        "properties": {
          "skill": {
            "type": "string",
            "title": "Skill"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
          },
          "tier": {
            "type": "string",
            "nullable": true,
            "title": "Tier"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "skill",
          "rationale"
        ],
        "title": "SkillGapItem"
      },
      "SkillGapsAnalysis": {
        "properties": {
          "has_data": {
            "type": "boolean",
            "title": "Has Data"
          },
          "message": {
            "type": "string",
            "nullable": true,
            "title": "Message"
          },
          "mandatory_gaps": {
            "items": {
              "$ref": "#/components/schemas/SkillGapItem"
            },
            "type": "array",
            "title": "Mandatory Gaps"
          },
          "preferred_gaps": {
            "items": {
              "$ref": "#/components/schemas/SkillGapItem"
            },
            "type": "array",
            "title": "Preferred Gaps"
          },
          "core_gaps": {
            "items": {
              "$ref": "#/components/schemas/SkillGapItem"
            },
            "type": "array",
            "title": "Core Gaps"
          },
          "matched_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Skills"
          },
          "undetermined_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Undetermined Skills"
          },
          "prioritized_gaps": {
            "items": {
              "$ref": "#/components/schemas/SkillGapItem"
            },
            "type": "array",
            "title": "Prioritized Gaps"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "has_data"
        ],
        "title": "SkillGapsAnalysis"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8001",
      "description": "Local FITMENT.AI Service (Default Port 8001)"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local FITMENT.AI Service (Alternative Port 8000)"
    }
  ]
}