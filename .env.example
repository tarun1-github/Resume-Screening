# FITMENT.AI — InstantFit AI Screening Configuration
# Rename this file to .env and provide your API keys.
# The application runs 100% reliably in Offline Deterministic mode even if all API keys are empty.

# --- GENERAL CONFIGURATION ---
LLM_ENABLED=true
LLM_PROVIDER=gemini
LLM_FALLBACK_ORDER=gemini,openrouter,nvidia,groq
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024

# --- APPLICATION STORAGE & DATABASE ---
FITMENT_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/fitment.db

# --- GOOGLE GEMINI (Free Tier Available) ---
# Model Options: gemini-3.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# --- OPENROUTER (Explicitly Free Models Available with :free suffix) ---
# Model Options: google/gemma-4-26b-a4b-it:free, google/gemma-4-31b-it:free, nvidia/nemotron-3.5-lightning:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# --- NVIDIA NIM (NVIDIA Build Cloud Catalog) ---
# Model Options: stepfun-ai/step-5-preview, z-ai/glm-5.3, meta/llama-3.1-70b-instruct
NVIDIA_API_KEY=
NVIDIA_MODEL=stepfun-ai/step-5-preview

# --- GROQ (Free Developer Tier) ---
# Model Options: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OPTIONAL PROVIDERS ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
